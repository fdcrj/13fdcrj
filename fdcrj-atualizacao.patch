@@ -0,0 +1,1525 @@
+{
+  "version": "BJCP 2021",
+  "scope": "Sínteses autorais do FDCRJ, não transcrições do guia. Notas históricas são exibidas somente quando pertinentes.",
+  "source": "https://www.bjcp.org/international-translations/portuguese-portugues/",
+  "summaries": [
+    {
+      "id": "0001",
+      "code": "1A",
+      "name": "American Light Lager",
+      "summary": "É uma lager muito clara e de perfil deliberadamente discreto, pensada para refrescar quando servida bem fria, sem sabores marcantes que dominem a experiência. O corpo leve e a carbonatação viva favorecem uma impressão seca e limpa; podem aparecer sutis notas de cereal, enquanto lúpulo e amargor ficam em segundo plano.",
+      "historicalNote": "A versão moderna surgiu com a Rheingold em 1967 e ganhou popularidade após a Miller adquirir a receita em 1973.",
