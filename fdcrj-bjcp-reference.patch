+      ]
+    },
+    {
+      "id": "0019",
+      "code": "6A",
+      "name": "Märzen",
+      "summary": "Espera-se uma lager alemã âmbar, de caráter maltado marcante, mas refinado: notas lembrando pão e leve tostado dão profundidade sem tornar a bebida pesada ou enjoativa. O amargor moderado e o final relativamente seco equilibram essa riqueza, enquanto fermentação limpa e textura macia sustentam uma impressão geral harmoniosa.",
+      "historicalNote": "A Märzen âmbar foi servida na Oktoberfest de 1872 a 1990, quando a Festbier dourada passou a ser a cerveja-padrão do festival.",
+      "sourceUrls": [
+        "https://www.bjcp.org/style/2021/6/6A/marzen/",
+        "https://www.bjcp.org/international-translations/portuguese-portugues/"
+      ]
