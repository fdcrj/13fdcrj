+    {
+      "id": "0020",
+      "code": "6B",
+      "name": "Rauchbier",
+      "summary": "Espera-se uma lager alemã âmbar em que a base maltada, tostada e lembrando pão sustente uma fumaça limpa de madeira, cuja presença pode ir de discreta a marcante sem apagar o conjunto. A impressão deve permanecer equilibrada, com amargor moderado, fermentação limpa e final relativamente seco; não se trata de uma cerveja necessariamente muito defumada.",
+      "historicalNote": "A Rauchbier é uma especialidade histórica de Bamberg, embora as origens desse estilo específico não estejam claras.",
+      "sourceUrls": [
+        "https://www.bjcp.org/style/2021/6/6B/rauchbier/",
+        "https://www.bjcp.org/wp-content/uploads/2024/03/bjcp-2021-pt-br-1.4.pdf"
+      ]
+    },
